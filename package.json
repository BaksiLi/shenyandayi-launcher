{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "deeplang",
  "title": "深言達意",
  "description": "透過深言達意尋詞、覓句，找到貼切的中文表達（非官方用戶端）。",
  "icon": "extension-icon.png",
  "author": "baksili",
  "categories": [
    "Productivity",
    "Developer Tools"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BaksiLi/shenyandayi-launcher.git"
  },
  "homepage": "https://github.com/BaksiLi/shenyandayi-launcher#readme",
  "bugs": {
    "url": "https://github.com/BaksiLi/shenyandayi-launcher/issues"
  },
  "commands": [
    {
      "name": "wantwords",
      "title": "尋詞",
      "subtitle": "深言達意 · WantWords",
      "description": "輸入意思、情境或英文描述，尋找貼切的中文詞語。",
      "mode": "view"
    },
    {
      "name": "wantquotes",
      "title": "覓句",
      "subtitle": "深言達意 · WantQuotes",
      "description": "輸入主題或意境，尋找相關的詩詞、名言與佳句。",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "useSystemOpencc",
      "type": "checkbox",
      "required": false,
      "default": true,
      "title": "繁簡轉換",
      "description": "使用內建 OpenCC 將繁體查詢轉為簡體；不需另外安裝。",
      "label": "搜尋前將繁體轉為簡體"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.88.4",
    "opencc-js": "1.4.2",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "20.8.10",
    "@types/react": "^18.2.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.4",
    "globals": "^15.14.0",
    "prettier": "^3.3.3",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.20.0"
  },
  "scripts": {
    "build": "ray build --environment dist --output dist --exit-on-error",
    "dev": "ray develop",
    "lint": "eslint src eslint.config.mjs --max-warnings 0",
    "check": "tsc --noEmit && npm run lint",
    "format:check": "prettier --check src package.json tsconfig.json eslint.config.mjs"
  }
}
